    {"id":"sourcing","label":"Sourcing","input":["part_number","condition","market"],"output":"ranked source options with provenance","approval":"human_review"},
    {"id":"qa","label":"Workshop QA","input":["evidence","procedure","as_built_record"],"output":"release and sign-off checklist","approval":"qualified_signoff"}
